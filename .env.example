# Copy this file to .env.local and add the connection string from your Neon project.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
