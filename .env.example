# Copy this file to .env.local and add the connection string from your Neon project.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Use a Stripe secret key that starts with sk_test_ while developing.
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_secret_key

# Required to verify payment updates. Set this from your Stripe webhook settings.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret
